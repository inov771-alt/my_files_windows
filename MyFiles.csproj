<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyFiles</RootNamespace>
    <AssemblyName>MyFiles</AssemblyName>
    <!-- Позволяет собирать проект и на не-Windows машинах (например, в CI на Linux) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Мои файлы</Product>
    <AssemblyTitle>Мои файлы — загрузка на files.spkmd.ru</AssemblyTitle>
    <Description>Загрузка файлов на сервер files.spkmd.ru из Проводника Windows</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
